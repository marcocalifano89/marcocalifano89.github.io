---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../data/content';
import { getContent, fallbackLocale, locales } from '../data/content';

const localePaths: Record<Locale, string> = {
  it: '/',
  en: '/en/'
};

const props = Astro.props as { locale?: Locale };
const locale: Locale = props.locale && locales.includes(props.locale) ? props.locale : fallbackLocale;
const content = getContent(locale);

const { head, nav, hero, metrics, pillars, experience, education, skills, certifications, contact, footer } = content;

const alternateLocale: Locale = locales.find((code) => code !== locale) ?? fallbackLocale;
const currentPath = localePaths[locale];
const alternatePath = localePaths[alternateLocale];
const localeRoutesScript = JSON.stringify(localePaths);

const emailCard = contact.cards.find((card) => card.href?.startsWith('mailto:'));
const phoneCard = contact.cards.find((card) => card.href?.startsWith('tel:'));

const metadataScript = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: nav.brand,
  jobTitle: hero.badge,
  url: 'https://marcocalifano89.github.io',
  image: 'https://marcocalifano89.github.io/assets/img/profile.jpeg',
  email: emailCard?.href ?? 'mailto:marcocalifano89@gmail.com',
  telephone: phoneCard?.href?.replace('tel:', '') ?? phoneCard?.text ?? '+393488782506',
  worksFor: {
    '@type': 'Organization',
    name: 'Reply'
  },
  sameAs: ['https://www.linkedin.com/in/marcocalifano/', 'https://github.com/marcocalifano89'],
  knowsAbout: hero.typing,
  description: head.description
});
void metadataScript;

const footerText = `\u00A9 ${new Date().getFullYear()} ${footer}`;
const navLabel = locale === 'it' ? 'Navigazione principale' : 'Primary navigation';
const backToTopLabel = locale === 'it' ? 'Torna in alto' : 'Back to top';
const credentialLabel = locale === 'it' ? 'Vedi credenziale' : 'View credential';
const highlightIcons = ['ri-magic-line', 'ri-brain-line', 'ri-team-line'];
const heroTagline =
  locale === 'it'
    ? 'Leader IT focalizzato su innovazione digitale, cloud, dati e AI.<br />Traduco la strategia in roadmap concrete e guido team cross-funzionali verso risultati misurabili.'
    : 'IT leader focused on digital innovation across cloud, data and AI transformations.<br />I turn strategy into executable roadmaps while leading cross-functional teams to measurable outcomes.';
const metricIcons = ['ri-stack-line', 'ri-cpu-line', 'ri-team-line'];
---
<BaseLayout title={head.title} description={head.description} keywords={head.keywords} lang={locale}>
  <meta slot="meta" property="og:title" content={head.title} />
  <meta slot="meta" property="og:description" content={head.ogDescription} />
  <script slot="meta" type="application/ld+json" is:inline>{metadataScript}</script>

  <header class="site-header" id="top">
    <div class="site-header__inner">
      <a class="site-header__brand" href="#top">{nav.brand}</a>
      <nav class="site-nav" aria-label={navLabel}>
        {nav.items.map((item) => (
          <a href={`#${item.id}`}>{item.label}</a>
        ))}
      </nav>
      <div class="site-header__controls">
        <a
          class="control control--language"
          href={alternatePath}
          aria-label={nav.languageSwitchSr}
          data-locale-target={alternateLocale}
        >
          {nav.languageSwitchLabel}
        </a>
        <button
          class="control control--theme"
          type="button"
          aria-pressed="true"
          data-theme-toggle
          data-label-light={nav.themeToggle.light}
          data-label-dark={nav.themeToggle.dark}
        >
          <span class="sr-only">{nav.themeToggle.light}</span>
          <i class="ri-moon-line" aria-hidden="true"></i>
        </button>
        <a
          class="button"
          href={hero.actions.primaryHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {hero.actions.primaryLabel}
        </a>
      </div>
    </div>
  </header>

  <main class="page">
    <section id="about" class="hero reveal">
      <span class="hero__parallax hero__parallax--primary" data-parallax data-depth="0.18" aria-hidden="true"></span>
      <span class="hero__parallax hero__parallax--secondary" data-parallax data-depth="0.28" aria-hidden="true"></span>
      <div class="hero__content">
        <span class="hero__badge">{hero.badge}</span>
        <p class="hero__tagline">{heroTagline}</p>
        <h1>{hero.title}</h1>
        <p class="hero__lead">{hero.lead}</p>
        <p class="hero__typing" aria-live="polite">
          <span class="typing"></span>
        </p>
        <div class="hero__highlights">
          {hero.highlights.map((highlight, index) => (
            <div class="hero__highlight">
              <i class={highlightIcons[index % highlightIcons.length]} aria-hidden="true"></i>
              <p>{highlight}</p>
            </div>
          ))}
        </div>
        <div class="hero__actions">
          <a class="button" href={hero.actions.primaryHref} target="_blank" rel="noopener noreferrer">
            {hero.actions.primaryLabel}
          </a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__image-frame">
          <img
            src="/assets/img/profile.jpeg"
            alt="Marco Califano"
            width="766"
            height="743"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section id="impact" class="section reveal">
      <div class="section-heading">
        <h2>{metrics.title}</h2>
        <p>{metrics.intro}</p>
      </div>
      <div class="metrics-grid">
        {metrics.items.map(({ value, label, detail }, index) => (
          <article class="metric-card reveal" style={`--metric-index:${index}`}>
            <div class="metric-card__icon">
              <i class={metricIcons[index % metricIcons.length]} aria-hidden="true"></i>
            </div>
            <div class="metric-card__body">
              <span class="metric-card__value">{value}</span>
              <h3>{label}</h3>
              <p>{detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="approach" class="section reveal">
      <div class="section-heading">
        <h2>{pillars.title}</h2>
        <p>{pillars.intro}</p>
      </div>
      <div class="pillars-grid">
        {pillars.items.map(({ title, blurb, points }) => (
          <article class="pillar-card reveal">
            <h3>{title}</h3>
            <p>{blurb}</p>
            <ul>
              {points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" class="section">
      <div class="section-heading">
        <h2>{experience.title}</h2>
        <p>{experience.intro}</p>
      </div>
      <div class="timeline timeline--alt">
        {experience.items.map(({ company, period, role, bullets }, index) => (
          <article class={`timeline-card reveal ${index % 2 === 1 ? 'timeline-card--invert' : ''}`}>
            <span class="timeline-card__dot" aria-hidden="true"></span>
            <div class="timeline-card__meta">
              <span class="timeline-card__company">{company}</span>
              <span class="timeline-card__period">{period}</span>
            </div>
            <h3>{role}</h3>
            <ul>
              {bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="education" class="section section--compact reveal">
      <div class="section-heading">
        <h2>{education.title}</h2>
        <p>{education.intro}</p>
      </div>
      <div class="timeline timeline--compact">
        {education.items.map(({ school, period, title, bullets }) => (
          <div class="timeline-item">
            <div class="timeline-item__header">
              <h3>{school}</h3>
              <span>{period}</span>
            </div>
            <div class="timeline-item__body">
              <div class="timeline-item__role">
                <h4>{title}</h4>
              </div>
              <ul>
                {bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="skills" class="section reveal">
      <div class="section-heading">
        <h2>{skills.title}</h2>
        <p>{skills.intro}</p>
      </div>
      <div class="skills-panel" data-skills>
        <div class="skills-tabs" role="tablist" aria-label={skills.title}>
          {skills.groups.map(({ category }, index) => (
            <button
              type="button"
              role="tab"
              class={`skills-tab ${index === 0 ? 'is-active' : ''}`}
              data-skill-tab={category}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
              aria-controls={`skills-pane-${index}`}
              id={`skills-tab-${index}`}
            >
              {category}
            </button>
          ))}
        </div>
        <div class="skills-panes">
          {skills.groups.map(({ category, items }, index) => (
            <div
              role="tabpanel"
              class={`skills-pane ${index === 0 ? 'is-active' : ''}`}
              data-skill-pane={category}
              id={`skills-pane-${index}`}
              aria-labelledby={`skills-tab-${index}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
              hidden={index === 0 ? undefined : true}
            >
              <div class="skills-pane__chips">
                {items.map((item) => <span class="chip chip--ghost">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="certifications" class="section reveal">
      <div class="section-heading">
        <h2>{certifications.title}</h2>
        <p>{certifications.intro}</p>
      </div>
      <div class="card-grid card-grid--cert">
        {certifications.items.map(({ name, issuer, href }) => (
          <article class="cert-card reveal">
            <div class="cert-card__meta">
              <h3>{name}</h3>
              <span>{issuer}</span>
            </div>
            <a class="cert-card__link" href={href} target="_blank" rel="noopener noreferrer">
              {credentialLabel}
              <i class="ri-external-link-line" aria-hidden="true"></i>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="section section--compact contact-section reveal">
      <div class="section-heading">
        <h2>{contact.title}</h2>
        <p>{contact.intro}</p>
      </div>
      <div class="contact-grid">
        {contact.cards.map(({ icon, label, text, href }) => (
          <article class="contact-card reveal">
            <i class={icon} aria-hidden="true"></i>
            <h3>{label}</h3>
            {href ? (
              <a href={href} rel="noopener noreferrer">{text}</a>
            ) : (
              <p>{text}</p>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>{footerText}</p>
  </footer>

  <button class="back-to-top" type="button" aria-label={backToTopLabel}>
    <i class="ri-arrow-up-line" aria-hidden="true"></i>
  </button>

  <script slot="scripts" is:inline data-phrases={JSON.stringify(hero.typing)}>
      const phrases = JSON.parse(document.currentScript.dataset.phrases || '[]');
      const target = document.querySelector('.typing');
      if (phrases.length && target) {
        const prefersReducedMotion =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          target.textContent = phrases[0] || '';
          return;
        }
        let phraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        const tick = () => {
          const current = phrases[phraseIndex];
          if (isDeleting) {
            charIndex = Math.max(0, charIndex - 1);
          } else {
            charIndex = Math.min(current.length, charIndex + 1);
          }
          target.textContent = current.slice(0, charIndex);
          if (!isDeleting && charIndex === current.length) {
            isDeleting = true;
            setTimeout(tick, 1600);
          } else if (isDeleting && charIndex === 0) {
            isDeleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            setTimeout(tick, 400);
          } else {
            const delay = isDeleting ? 45 : 90;
            setTimeout(tick, delay);
          }
        };
        tick();
      }
    </script>
  <script
    slot="scripts"
    is:inline
    data-locale-routes={localeRoutesScript}
    data-current-locale={locale}
    data-current-path={currentPath}
  >
      const scriptEl = document.currentScript;
      let routeMap = {"it":"/","en":"/en/"};
      let initialLocale = '${locale}';

      if (scriptEl instanceof HTMLScriptElement) {
        if (scriptEl.dataset.localeRoutes) {
          try {
            routeMap = JSON.parse(scriptEl.dataset.localeRoutes);
          } catch (error) {
            routeMap = {"it":"/","en":"/en/"};
          }
        }
        if (scriptEl.dataset.currentLocale) {
          initialLocale = scriptEl.dataset.currentLocale;
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        const docEl = document.documentElement;
        const backToTopEl = document.querySelector('.back-to-top');
        const themeToggleEl = document.querySelector('[data-theme-toggle]');
        const localeToggleEl = document.querySelector('[data-locale-target]');
        const brandLink = document.querySelector('.site-header__brand');
        const backToTopButton = backToTopEl instanceof HTMLElement ? backToTopEl : null;
        const themeButton = themeToggleEl instanceof HTMLElement ? themeToggleEl : null;
        const localeButton = localeToggleEl instanceof HTMLAnchorElement ? localeToggleEl : null;
        const scrollProgressEl = document.querySelector('.scroll-progress__bar');
        const revealEls = Array.from(document.querySelectorAll('.reveal'));
        const skillsRoot = document.querySelector('[data-skills]');
        const skillTabs = skillsRoot ? Array.from(skillsRoot.querySelectorAll('[data-skill-tab]')) : [];
        const skillPanes = skillsRoot ? Array.from(skillsRoot.querySelectorAll('[data-skill-pane]')) : [];
        const heroSection = document.querySelector('.hero');
        let parallaxItems = [];
        const currentLocale = docEl.lang || initialLocale;
        let storedLocale = null;

        try {
          storedLocale = localStorage.getItem('locale');
        } catch (error) {
          storedLocale = null;
        }

        if (storedLocale && storedLocale !== currentLocale) {
          const targetPath = routeMap[storedLocale] || '/';
          if (window.location.pathname !== targetPath) {
            const search = window.location.search || '';
            const hash = window.location.hash || '';
            window.location.replace(`${targetPath}${search}${hash}`);
            return;
          }
        }

        try {
          localStorage.setItem('locale', currentLocale);
        } catch (error) {
          // Storage might be unavailable; ignore
        }

        const prefersReducedMotion =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion && heroSection) {
          parallaxItems = Array.from(heroSection.querySelectorAll('[data-parallax]'));
        } else if (prefersReducedMotion && heroSection) {
          heroSection
            .querySelectorAll('[data-parallax]')
            .forEach((element) => element.removeAttribute('style'));
        }

        if (revealEls.length) {
          if (prefersReducedMotion) {
            revealEls.forEach((element) => element.classList.add('is-visible'));
          } else if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
              (entries, obs) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.2, rootMargin: '0px 0px -10%' }
            );
            revealEls.forEach((element) => observer.observe(element));
          } else {
            revealEls.forEach((element) => element.classList.add('is-visible'));
          }
        }

        const updateParallax = () => {
          if (!parallaxItems.length || !heroSection) return;
          const rect = heroSection.getBoundingClientRect();
          const centerY = rect.top + rect.height / 2;
          const viewportCenter = window.innerHeight / 2;
          const deltaY = centerY - viewportCenter;
          parallaxItems.forEach((item) => {
            const depth = Number(item.getAttribute('data-depth') || '0.15');
            const translateY = -deltaY * depth;
            item.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0)`;
          });
        };

        const toggleVisibility = () => {
          if (!backToTopButton) return;
          if (window.scrollY > 320) {
            backToTopButton.classList.add('back-to-top--visible');
          } else {
            backToTopButton.classList.remove('back-to-top--visible');
          }
        };

        const updateScrollProgress = () => {
          if (!scrollProgressEl) return;
          const scrollable = docEl.scrollHeight - window.innerHeight;
          const ratio = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
          const clamped = Math.max(0, Math.min(100, ratio));
          scrollProgressEl.style.width = `${clamped.toFixed(2)}%`;
        };

        const setActiveSkill = (targetId) => {
          if (!targetId) return;
          skillTabs.forEach((tab) => {
            const isActive = tab.dataset.skillTab === targetId;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            tab.setAttribute('tabindex', isActive ? '0' : '-1');
          });
          skillPanes.forEach((pane) => {
            const isActive = pane.dataset.skillPane === targetId;
            pane.classList.toggle('is-active', isActive);
            if (isActive) {
              pane.removeAttribute('hidden');
              pane.setAttribute('aria-hidden', 'false');
            } else {
              pane.setAttribute('hidden', '');
              pane.setAttribute('aria-hidden', 'true');
            }
          });
        };

        if (skillTabs.length && skillPanes.length) {
          const defaultTab =
            skillTabs.find((tab) => tab.classList.contains('is-active')) ?? skillTabs[0];
          if (defaultTab && defaultTab.dataset.skillTab) {
            setActiveSkill(defaultTab.dataset.skillTab);
          }

          skillTabs.forEach((tab, index) => {
            tab.addEventListener('click', () => {
              const targetId = tab.dataset.skillTab;
              if (targetId) {
                setActiveSkill(targetId);
              }
            });

            tab.addEventListener('keydown', (event) => {
              if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
                return;
              }
              event.preventDefault();
              const total = skillTabs.length;
              let nextIndex = index;
              if (event.key === 'ArrowRight') {
                nextIndex = (index + 1) % total;
              } else if (event.key === 'ArrowLeft') {
                nextIndex = (index - 1 + total) % total;
              } else if (event.key === 'Home') {
                nextIndex = 0;
              } else if (event.key === 'End') {
                nextIndex = total - 1;
              }
              const nextTab = skillTabs[nextIndex];
              if (nextTab) {
                nextTab.focus();
                if (nextTab.dataset.skillTab) {
                  setActiveSkill(nextTab.dataset.skillTab);
                }
              }
            });
          });
        }

        const persistTheme = (/** @type {'light' | 'dark'} */ theme) => {
          try {
            localStorage.setItem('theme', theme);
          } catch (error) {
            // Storage might be unavailable; ignore
          }
        };

        const getCurrentTheme = () =>
          /** @type {'light' | 'dark'} */ (docEl.dataset.theme === 'light' ? 'light' : 'dark');

        const updateThemeButton = () => {
          if (!themeButton) return;
          const currentTheme = getCurrentTheme();
          const srTarget = themeButton.querySelector('.sr-only');
          const icon = themeButton.querySelector('i');
          const dataset = themeButton.dataset;
          const nextLabel =
            currentTheme === 'dark' ? dataset.labelLight : dataset.labelDark;
          if (srTarget && nextLabel) {
            srTarget.textContent = nextLabel;
          }
          if (icon) {
            icon.className = currentTheme === 'dark' ? 'ri-moon-line' : 'ri-sun-line';
            icon.setAttribute('aria-hidden', 'true');
          }
          themeButton.setAttribute('aria-pressed', currentTheme === 'dark' ? 'true' : 'false');
        };

        const setTheme = (/** @type {'light' | 'dark'} */ theme, /** @type {boolean} */ shouldPersist = true) => {
          docEl.dataset.theme = theme;
          if (shouldPersist) {
            persistTheme(theme);
          }
          updateThemeButton();
        };

        const initTheme = () => {
          try {
            const stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') {
              docEl.dataset.theme = stored;
            } else if (window.matchMedia) {
              docEl.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
          } catch (error) {
            docEl.dataset.theme = 'dark';
          }
          updateThemeButton();
        };

        initTheme();

        if (themeButton) {
          themeButton.addEventListener('click', (event) => {
            event.preventDefault();
            const nextTheme = getCurrentTheme() === 'dark' ? 'light' : 'dark';
            setTheme(nextTheme);
          });
        }

        if (localeButton) {
          localeButton.addEventListener('click', () => {
            const targetLocale = localeButton.dataset.localeTarget;
            if (targetLocale) {
              try {
                localStorage.setItem('locale', targetLocale);
              } catch (error) {
                // Storage might be unavailable; ignore
              }
            }
          });
        }

        if (brandLink instanceof HTMLAnchorElement) {
          brandLink.addEventListener('click', (event) => {
            event.preventDefault();
            if (prefersReducedMotion) {
              window.scrollTo(0, 0);
            } else {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          });
        }

        if (window.matchMedia) {
          const media = window.matchMedia('(prefers-color-scheme: dark)');
          const handleChange = (/** @type {MediaQueryListEvent} */ event) => {
            let storedPreference = null;
            try {
              storedPreference = localStorage.getItem('theme');
            } catch (error) {
              storedPreference = null;
            }
            if (!storedPreference) {
              setTheme(event.matches ? 'dark' : 'light', false);
            }
          };
          if (typeof media.addEventListener === 'function') {
            media.addEventListener('change', handleChange);
          }
        }

        const handleScroll = () => {
          toggleVisibility();
          updateScrollProgress();
          updateParallax();
        };

        handleScroll();
        window.addEventListener('scroll', handleScroll, { passive: true });
        if (!prefersReducedMotion) {
          window.addEventListener('resize', updateParallax);
        }

        if (backToTopButton) {
          backToTopButton.addEventListener('click', () => {
            if (prefersReducedMotion) {
              window.scrollTo(0, 0);
            } else {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          });
        }
      });
    </script>
</BaseLayout>
