---
<BaseLayout title={pageTitle} description={pageDescription}>
  <astro:fragment slot="meta">
    <meta name="keywords" content="Marco Califano, Solution Architect, Cloud Architect, AWS, Azure, GCP, Enterprise Architecture" />
    <meta name="author" content="Marco Califano" />
    <meta property="og:title" content="Marco Califano — Solution Architect" />
    <meta property="og:description" content="Certified Enterprise & Solution Architect leading multi-cloud strategies, innovation programmes and data-driven transformation." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://marcocalifano89.github.io" />
    <meta property="og:image" content="https://marcocalifano89.github.io/solutionarchitect.png" />
    <meta name="theme-color" content="#101829" />
    <script type="application/ld+json">{JSON.stringify(structuredData)}</script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-169007209-3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'UA-169007209-3');
    </script>
  </astro:fragment>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-header__brand" href="#about">Marco Califano</a>
      <nav class="site-nav">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#certifications">Certifications</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="button button--ghost" href="https://drive.google.com/file/d/1Ik4bvW0YoHdVsm_CBipPkPgcaRpKqVvA/view?usp=drive_link" target="_blank" rel="noopener noreferrer">Download CV</a>
    </div>
  </header>

  <main class="page">
    <section id="about" class="hero">
      <div class="hero__content">
        <span class="hero__badge">Enterprise &amp; Solution Architect</span>
        <h1>Ciao, sono Marco.</h1>
        <p class="hero__lead">
          Progetto e guido architetture cloud, data &amp; AI per grandi organizzazioni, trasformando roadmap strategiche in risultati concreti e misurabili.
        </p>
        <p class="hero__typing">Specialised in <span class="typing" aria-live="polite"></span></p>
        <div class="hero__highlights">
          {heroHighlights.map((item) => (
            <span class="chip" key={item}>{item}</span>
          ))}
        </div>
        <div class="hero__actions">
          <a class="button" href="https://drive.google.com/file/d/1Ik4bvW0YoHdVsm_CBipPkPgcaRpKqVvA/view?usp=drive_link" target="_blank" rel="noopener noreferrer">Scarica il CV</a>
          <a class="button button--ghost" href="#contact">Qui i miei contatti</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__image-frame">
          <img src="/assets/img/profile.jpeg" alt="Portrait of Marco Califano" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <section class="section metrics">
      <div class="section-heading">
        <h2>Impact snapshot</h2>
        <p>Una panoramica dei risultati più ricorrenti che porto nei programmi enterprise.</p>
      </div>
      <div class="card-grid metrics__grid">
        {metrics.map(({ value, label, detail }) => (
          <article class="metric-card" key={label}>
            <span class="metric-card__value">{value}</span>
            <h3>{label}</h3>
            <p>{detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section pillars">
      <div class="section-heading">
        <h2>Come affronto i programmi</h2>
        <p>Un framework in tre fasi che accompagna clienti e team dall’allineamento strategico alla delivery misurabile.</p>
      </div>
      <div class="pillars-grid">
        {approachPillars.map(({ title, blurb, points }) => (
          <article class="pillar-card" key={title}>
            <h3>{title}</h3>
            <p>{blurb}</p>
            <ul>
              {points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" class="section">
      <div class="section-heading">
        <h2>Experience</h2>
        <p>Ruoli di leadership tecnica e strategica, con un approccio hands-on che connette business, architettura e delivery.</p>
      </div>
      <div class="timeline">
        {experiences.map(({ company, period, role, bullets }) => (
          <div class="timeline-item" key={company + period}>
            <div class="timeline-item__marker" aria-hidden="true"></div>
            <div class="timeline-item__content">
              <div class="timeline-item__meta">
                <span class="timeline-item__period">{period}</span>
                <h3>{role}</h3>
                <p class="timeline-item__company">{company}</p>
              </div>
              <ul>
                {bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="education" class="section section--compact">
      <div class="section-heading">
        <h2>Education</h2>
        <p>Formazione ingegneristica con forte attenzione a telecomunicazioni, sistemi distribuiti e innovazione.</p>
      </div>
      <div class="timeline timeline--compact">
        {education.map(({ school, title, period, bullets }) => (
          <div class="timeline-item" key={school}>
            <div class="timeline-item__marker" aria-hidden="true"></div>
            <div class="timeline-item__content">
              <div class="timeline-item__meta">
                <span class="timeline-item__period">{period}</span>
                <h3>{title}</h3>
                <p class="timeline-item__company">{school}</p>
              </div>
              <ul>
                {bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="skills" class="section">
      <div class="section-heading">
        <h2>Focus areas &amp; skills</h2>
        <p>Competenze principali su cui costruisco strategie, architetture e delivery roadmap.</p>
      </div>
      <div class="skills-grid">
        {skillGroups.map(({ category, items }) => (
          <article class="skills-card" key={category}>
            <h3>{category}</h3>
            <div class="skills-card__chips">
              {items.map((item) => (
                <span class="chip chip--ghost" key={item}>{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="certifications" class="section">
      <div class="section-heading">
        <h2>Certifications</h2>
        <p>Credenziali che attestano il mio impegno continuo nell'evoluzione tecnologica e metodologica.</p>
      </div>
      <div class="card-grid">
        {certifications.map(({ name, issuer, href }) => (
          <article class="cert-card" key={name}>
            <h3>{name}</h3>
            <p>{issuer}</p>
            <a class="cert-card__link" href={href} target="_blank" rel="noopener noreferrer">Vedi credenziale</a>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="section section--compact">
      <div class="section-heading">
        <h2>Contact</h2>
        <p>Scrivimi per discutere del tuo prossimo progetto o per una consulenza architetturale.</p>
      </div>
      <div class="contact-grid">
        {contactCards.map(({ icon, label, text, href }) => (
          <article class="contact-card" key={label}>
            <i class={icon} aria-hidden="true"></i>
            <h3>{label}</h3>
            {href ? (
              <a href={href} rel="noopener noreferrer">{text}</a>
            ) : (
              <p>{text}</p>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>&copy; {new Date().getFullYear()} Marco Califano — Enterprise &amp; Solution Architect.</p>
  </footer>

  <astro:fragment slot="scripts">
    <script type="module" data-phrases={JSON.stringify(typedPhrases)}>
      const phrases = JSON.parse(document.currentScript.dataset.phrases || '[]');
      const target = document.querySelector('.typing');
      if (phrases.length && target) {
        let phraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        const tick = () => {
          const current = phrases[phraseIndex];
          if (isDeleting) {
            charIndex = Math.max(0, charIndex - 1);
          } else {
            charIndex = Math.min(current.length, charIndex + 1);
          }
          target.textContent = current.slice(0, charIndex);
          if (!isDeleting && charIndex === current.length) {
            isDeleting = true;
            setTimeout(tick, 1600);
          } else if (isDeleting && charIndex === 0) {
            isDeleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            setTimeout(tick, 400);
          } else {
            const delay = isDeleting ? 45 : 90;
            setTimeout(tick, delay);
          }
        };
        tick();
      }
    </script>
  </astro:fragment>
</BaseLayout>
