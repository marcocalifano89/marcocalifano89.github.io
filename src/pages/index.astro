  jobTitle: 'Enterprise & Solution Architect',
  url: 'https://marcocalifano89.github.io',
  image: 'https://marcocalifano89.github.io/assets/img/profile.jpeg',
  email: 'mailto:marcocalifano89@gmail.com',
  telephone: '+39-348-878-2506',
  worksFor: {
    '@type': 'Organization',
    name: 'Reply'
  },
  sameAs: [
    'https://www.linkedin.com/in/marcocalifano/',
    'https://github.com/marcocalifano89'
  ],
  knowsAbout: [
    'Cloud Architecture',
    'Enterprise Architecture',
    'DevOps',
    'Generative AI',
